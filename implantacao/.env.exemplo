# Atende.IA — configuração de PRODUÇÃO. Copie para .env e preencha:
#   cp .env.exemplo .env && nano .env && chmod 600 .env
# O arquivo .env NUNCA vai para o Git (está no .gitignore).
# Gere senhas fortes com:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# ---- Domínio (DNS: registro A apontando para o IP público da VM)
DOMINIO=seudominio.com.br
SITE_ORIGIN=https://seudominio.com.br

# ---- Banco de dados
# Senha do dono do banco (postgres). Usada só por migração, backup e manutenção.
POSTGRES_PASSWORD=troque-por-uma-senha-forte-1
# Senha do papel da aplicação (atende_app), que respeita o isolamento por empresa. 16+ caracteres.
ATENDE_APP_SENHA=troque-por-uma-senha-forte-2
# Repita as senhas acima nas duas URLs abaixo.
DATABASE_URL=postgres://atende_app:troque-por-uma-senha-forte-2@127.0.0.1:5432/atende
DATABASE_URL_DONO=postgres://postgres:troque-por-uma-senha-forte-1@127.0.0.1:5432/atende

# ---- Segurança
# Administrador só entra no painel depois de ativar a verificação em duas etapas (código do celular).
ATENDE_MFA_ADMIN=1

# ---- IA (Gemini). Use uma chave de projeto COM faturamento ativado:
# no plano gratuito, o Google pode usar o conteúdo das conversas para melhorar os produtos dele.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Teto de chamadas da IA por dia (site + WhatsApp) e só do chat do site. Passou, usa respostas prontas.
ATENDE_IA_LIMITE_DIA=1500
ATENDE_IA_LIMITE_SITE_DIA=300

# ---- WhatsApp Cloud API (deixe tudo vazio para desligar)
# Callback URL na Meta: https://seudominio.com.br/webhook/whatsapp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# ID da empresa dona deste número (painel do admin > Empresas). Obrigatório no banco.
WHATSAPP_EMPRESA_ID=
# Em teste, limite a números conhecidos, separados por vírgula. Em produção, deixe vazio.
WHATSAPP_ALLOWED_NUMBERS=
